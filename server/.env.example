# Server Port (Optional - defaults to 5000 locally)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection String (Required)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/expensedb?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/expensedb

# JWT Secret for authentication (Required - use strong random string in production)
JWT_SECRET=your_super_secret_jwt_key_here

# JWT Expiration time (Optional - defaults to 7d)
JWT_EXPIRE=7d

# Allowed CORS Origins (Optional - comma-separated list of allowed origins, or '*' for all)
# Example for production: https://your-frontend-domain.com,https://admin.your-domain.com
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
